<odoo>
    <record id="property_report" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
        <field name="report_name">estate.property_report_template</field>
    </record>


    <template id="property_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="rec">
                    <h1>Property Reports</h1>
                    <style>
                        table {
                        width:100%;
                        border:1px solid #b3adad;
                        border-collapse:collapse;
                        text-align:center;
                        padding:5px;
                        }
                        table th {
                        border:1px solid #b3adad;
                        padding:5px;
                        background: #f0f0f0;
                        color: #313030;
                        }
                        table td {
                        border:1px solid #b3adad;
                        text-align:center;
                        padding:5px;
                        background: #ffffff;
                        color: #313030;
                        }
                    </style>
                    <table>
                        <thead>
                            <tr>
                                <th colspan="4">General Information</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Name</td>
                                <td><t t-esc="rec.name"/></td>
                                <td>Postcode</td>
                                <td><t t-out="rec.postcode"/></td>
                            </tr>
                        </tbody>

                        <thead>
                            <tr>
                                <th colspan="4">Additional Information</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Owner</td>
                                <td><t t-out="rec.owner_id.name"/></td>
                                <td>Phone</td>
                                <td><t t-out="rec.owner_phone"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>
                    <table>
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Area(m2)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rec.line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <t t-esc="line.description"/>
                                    </td>
                                    <td>
                                        <t t-esc="line.area"/>
                                    </td>
                                </tr>

                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </t>
    </template>
</odoo>